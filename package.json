{
  "name": "raiz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "matrix:setup": "node scripts/setup-matrix.mjs",
    "matrix:up": "docker compose up -d --wait",
    "matrix:user": "docker compose exec synapse register_new_matrix_user -c /data/homeserver.yaml http://localhost:8008",
    "matrix:down": "docker compose down"
  },
  "dependencies": {
    "lucide-react": "1.52.0",
    "matrix-js-sdk": "43.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
